# Template only. All values intentionally empty.
# Server-only Appwrite configuration; no browser SDK required in the initial SSR design.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Runtime PostgreSQL credential (limited application role / pooler).
DATABASE_URL=
# Migration-only values; do not automatically copy into the web runtime.
DIRECT_URL=
SHADOW_DATABASE_URL=
# Origin used for URL construction and request origin validation; set per environment.
APP_URL=
